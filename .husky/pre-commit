npm run lint


branch=$(git symbolic-ref --short HEAD)

pattern='^PROJ-[0-9]+\/(feat|fix|chore|docs|style|refactor|perf|test|revert|ci)\/[a-z0-9-]+$'

if ! echo "$branch" | grep -qE "$pattern"; then
  echo ""
  echo "Invalid branch name: $branch"
  echo ""
  echo "Correct formate is: PROJ-123/feat/branch-name"
  echo ""
  echo "Allowed types: feat, fix, chore, docs, style, refactor, perf, test, revert, ci"
  echo ""
  exit 1
fi